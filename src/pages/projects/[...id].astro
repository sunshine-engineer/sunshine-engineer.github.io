---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { published } from '../../lib/content';
import { href } from '../../config';
export async function getStaticPaths() {
  return (await published('projects')).map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const video = project.data.video
  ? await getEntry(project.data.video)
  : undefined;
---

<Base title={project.data.title} description={project.data.summary}>
  <header class="detail-header wrap">
    <a class="eyebrow" href={href('projects/')}>
      ← ALL PROJECTS
    </a>
    <p class="eyebrow" style="margin-top:25px">
      INDEPENDENT PROJECT / {project.data.status}
    </p>
    <h1>{project.data.title}</h1>
    <p class="summary">{project.data.summary}</p>
    <ul class="tags">
      {project.data.tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
    <div class="actions">
      <a class="button" href={project.data.repository}>
        View source on GitHub ↗
      </a>
      {project.data.demo && (
        <a class="text-link" href={project.data.demo}>
          Live demo ↗
        </a>
      )}
      {video && !video.data.draft && (
        <a class="text-link" href={href(`videos/${video.id}/`)}>
          Watch walkthrough →
        </a>
      )}
    </div>
  </header>
  <div class="detail-layout wrap">
    <article class="prose">
      {project.data.cover && (
        <img
          class="detail-cover"
          src={href(project.data.cover)}
          alt={`Architecture overview for ${project.data.title}`}
          width="800"
          height="440"
        />
      )}
      <Content />
    </article>
    <aside class="toc">
      <p class="eyebrow">IN THIS CASE STUDY</p>
      <ol>
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
      </ol>
    </aside>
  </div>
</Base>
